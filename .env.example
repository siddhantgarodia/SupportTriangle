# SupportTriangle Environment Configuration
# Copy this file to .env and fill in the values

# Groq API Key (get from https://console.groq.com)
GROQ_API_KEY=gsk_your_api_key_here

# JWT Secret for session tokens (generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=your_secret_key_here_minimum_32_characters

# Allowed origins for CORS (comma-separated, defaults to localhost for development)
# For production on Vercel, set to: https://your-domain.vercel.app
ALLOWED_ORIGINS=http://localhost:5173

# SQLite database path (optional, defaults to support_triage.db in project root)
# SQLITE_PATH=/tmp/support_triage.db

# Enable synchronous ticket processing (set to true on Vercel, false for local development)
# SYNC_TICKET_PROCESSING=false

# Groq API call delay in seconds (to respect rate limits)
# GROQ_INTER_CALL_DELAY_SEC=5
